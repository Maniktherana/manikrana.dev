{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "www",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "apps/www",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "www-static",
      "runtimeExecutable": "bunx",
      "runtimeArgs": [
        "serve@14.2.5",
        "apps/www/.vercel/output/static",
        "-l",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "storybook",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "apps/storybook",
        "dev"
      ],
      "port": 6006,
      "autoPort": true
    },
    {
      "name": "design",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "apps/design",
        "dev"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "design-static",
      "runtimeExecutable": "bunx",
      "runtimeArgs": [
        "serve@14.2.5",
        "apps/design/.output/public",
        "-l",
        "4174"
      ],
      "port": 4174
    }
  ]
}
